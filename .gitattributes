# Set default behavior to automatically normalize line endings
* text=auto

# Force CRLF line endings for C# source files and batch files
*.cs text eol=crlf
*.bat text eol=crlf

# Force LF line endings for Markdown documentation
*.md text eol=lf

# Mark binary files to prevent git from modifying them
*.png binary
*.ico binary
*.pptx binary
*.exe binary
*.dll binary
